{
  "repo": "gmedia/notnote",
  "login": "your-github-login",
  "agents": [
    {
      "id": "alpha-1",
      "host": "local",
      "tokenClass": "fine-grained"
    },
    {
      "id": "beta-1",
      "host": "user@host-b",
      "tokenClass": "classic",
      "acceptedRisks": [
        {
          "rule": "ssh-key-write",
          "reason": "shared general-purpose gh credential on this host"
        }
      ]
    },
    {
      "id": "gamma-1",
      "host": "user@host-c",
      "tokenClass": "fine-grained"
    },
    {
      "id": "delta-1",
      "host": "user@host-d",
      "tokenClass": "fine-grained"
    }
  ]
}
