{
  "name": "notnote",
  "version": "0.0.0",
  "private": true,
  "description": "Collaborative workspace with high-fidelity Notion migration",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
