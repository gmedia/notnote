    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@notnote/shared": "workspace:*",
    "@notnote/editor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
